<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/xampp/htdocs/hitungan-turbine/www/application/database.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="125"/><column_width id="3" width="3136"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,6:mainenergy"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="energy" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="96"/><column index="2" value="91"/><column index="3" value="174"/><column index="4" value="168"/><column index="5" value="123"/><column index="6" value="140"/><column index="7" value="88"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="57"/><column index="2" value="52"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">CREATE TABLE energy (
  id_energy INTEGER PRIMARY KEY AUTOINCREMENT,
  waktu DATE DEFAULT CURRENT_TIMESTAMP,
  flow_kwh_synchro DECIMAL(10,2),
  flow_kwh_turbine DECIMAL(10,2),
  hasil_turbine DECIMAL(10,3),
  flow_kwh_PLN DECIMAL(10,2),
  hasil_pln DECIMAL(10,3)
);

INSERT INTO energy (waktu, flow_kwh_synchro, flow_kwh_turbine, hasil_turbine, flow_kwh_PLN, hasil_pln)
VALUES
  ('2023-12-31', 17681.00, 3621595.90, 0.000, 25380.00, NULL),
  ('2024-01-01', 17681.00, 3621677.00, 8.110, 25380.00, 0.000);

CREATE TABLE hasil (
  id_hasil INTEGER PRIMARY KEY AUTOINCREMENT,
  id_energy INTEGER,
  day_turbine DECIMAL(10,3),
  day_synchro DECIMAL(10,3),
  day_pln DECIMAL(10,3),
  avg_turbine DECIMAL(10,3),
  avg_synchro DECIMAL(10,3),
  avg_pln DECIMAL(10,3),
  month_turbine DECIMAL(10,3),
  month_synchro DECIMAL(10,3),
  month_pln DECIMAL(10,3),
  
  FOREIGN KEY (id_energy) REFERENCES energy (id_energy)
);

CREATE TABLE hours (
  id_hours INTEGER PRIMARY KEY AUTOINCREMENT,
  id_hasil INTEGER,
  turbine_jam INTEGER,
  synchro_jam INTEGER,
  pln_jam INTEGER,
  
  FOREIGN KEY (id_hasil) REFERENCES hasil (id_hasil)
);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
